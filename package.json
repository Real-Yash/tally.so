{
  "name": "tallyclone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TallyPrime-style accounting application built from a clean-room assessment of TallyPrime 7.2.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config vite.config.js\"",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js",
    "preview": "npm run build && node server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
